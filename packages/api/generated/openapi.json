{
  "openapi": "3.1.0",
  "info": {
    "title": "Calendar Booking API",
    "version": "0.0.0"
  },
  "tags": [
    {
      "name": "Guest"
    },
    {
      "name": "Admin"
    },
    {
      "name": "Meta"
    }
  ],
  "paths": {
    "/api/v1/admin/bookings": {
      "get": {
        "operationId": "listBookings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/v1/admin/meeting-types": {
      "post": {
        "operationId": "createMeetingType",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Тип встречи в ответе на создание (код 201).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "400": {
            "description": "400 — ошибка валидации запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMeetingTypeRequest"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listAdminMeetingTypes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdminMeetingType"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/v1/admin/meeting-types/{id}": {
      "get": {
        "operationId": "getAdminMeetingType",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMeetingType"
                }
              }
            }
          },
          "404": {
            "description": "404 — ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Admin"
        ]
      }
    },
    "/api/v1/bookings": {
      "post": {
        "operationId": "createBooking",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Бронирование в ответе на создание (код 201).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "400 — ошибка валидации запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "404 — ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "409 — конфликт: слот занят или время вне окна записи/графика работы.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Guest"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/meeting-types": {
      "get": {
        "operationId": "listMeetingTypes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GuestMeetingType"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Guest"
        ]
      }
    },
    "/api/v1/meeting-types/{id}": {
      "get": {
        "operationId": "getMeetingType",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestMeetingType"
                }
              }
            }
          },
          "404": {
            "description": "404 — ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Guest"
        ]
      }
    },
    "/api/v1/meeting-types/{id}/slots": {
      "get": {
        "operationId": "listAvailableSlots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SlotsDay"
                  }
                }
              }
            }
          },
          "404": {
            "description": "404 — ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "tags": [
          "Guest"
        ]
      }
    },
    "/api/v1/messages": {
      "get": {
        "operationId": "getMessages",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesPayload"
                }
              }
            }
          }
        },
        "tags": [
          "Meta"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminMeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор типа встречи (UUID)."
          },
          "name": {
            "type": "string",
            "description": "Название: 1–100 символов."
          },
          "description": {
            "type": "string",
            "description": "Описание: 0–1000 символов."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "Длительность в целых минутах: 5–540."
          }
        },
        "description": "Тип встречи — представление владельца календаря."
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Машиночитаемый код из фиксированного списка `ErrorCode`."
          },
          "message": {
            "type": "string",
            "description": "Человекочитаемое описание ошибки."
          }
        },
        "description": "Общая форма ошибки: машиночитаемый код и человекочитаемое сообщение."
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "meetingTypeId",
          "meetingTypeName",
          "guestName",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор бронирования (UUID)."
          },
          "meetingTypeId": {
            "type": "string",
            "description": "Идентификатор забронированного типа встречи (UUID)."
          },
          "meetingTypeName": {
            "type": "string",
            "description": "Название типа встречи на момент бронирования (типы не редактируются)."
          },
          "guestName": {
            "type": "string",
            "description": "Имя гостя: 1–100 символов."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало встречи, момент с offset +03:00."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец встречи: start + длительность типа встречи."
          }
        },
        "description": "Бронирование — запись гостя на слот по выбранному типу встречи."
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "start",
          "guestName"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "string",
            "description": "Идентификатор типа встречи (UUID)."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Желаемое начало встречи по сетке слотов; offset любой — сервер интерпретирует\nмомент и валидирует его по сетке и окну в UTC+3."
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:.*\\S)?$",
            "description": "Имя гостя: 1–100 символов, не из одних пробелов, без пробелов по краям."
          }
        },
        "description": "Запрос на создание бронирования."
      },
      "CreateMeetingTypeRequest": {
        "type": "object",
        "required": [
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:.*\\S)?$",
            "description": "Название: 1–100 символов, не из одних пробелов, без пробелов по краям."
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "description": "Описание: 0–1000 символов."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 540,
            "description": "Длительность в целых минутах: 5–540."
          }
        },
        "description": "Запрос на создание типа встречи."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_failed",
          "meeting_type_not_found",
          "slot_taken",
          "outside_window",
          "outside_schedule"
        ],
        "description": "Машиночитаемые коды ошибок API."
      },
      "GuestMeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор типа встречи (UUID)."
          },
          "name": {
            "type": "string",
            "description": "Название: 1–100 символов."
          },
          "description": {
            "type": "string",
            "description": "Описание: 0–1000 символов."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "Длительность в целых минутах: 5–540."
          }
        },
        "description": "Тип встречи — представление гостя."
      },
      "Messages": {
        "type": "object",
        "required": [
          "common",
          "home",
          "booking",
          "admin",
          "errors"
        ],
        "properties": {
          "common": {
            "$ref": "#/components/schemas/MessagesCommon",
            "description": "Общие подписи, общие для всех разделов."
          },
          "home": {
            "$ref": "#/components/schemas/MessagesHome",
            "description": "Главная страница."
          },
          "booking": {
            "$ref": "#/components/schemas/MessagesBooking",
            "description": "Гостевой сценарий: выбор типа, мастер записи, экран успеха."
          },
          "admin": {
            "$ref": "#/components/schemas/MessagesAdmin",
            "description": "Раздел владельца календаря."
          },
          "errors": {
            "$ref": "#/components/schemas/MessagesErrors",
            "description": "Тексты ошибок."
          }
        },
        "description": "Каталог текстов целиком."
      },
      "MessagesAdmin": {
        "type": "object",
        "required": [
          "title",
          "tabs",
          "meetingTypes",
          "meetingTypeDetail",
          "createModal",
          "bookings"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Заголовок раздела."
          },
          "tabs": {
            "$ref": "#/components/schemas/MessagesAdminTabs",
            "description": "Названия вкладок."
          },
          "meetingTypes": {
            "$ref": "#/components/schemas/MessagesAdminMeetingTypes",
            "description": "Вкладка типов встреч."
          },
          "meetingTypeDetail": {
            "$ref": "#/components/schemas/MessagesAdminMeetingTypeDetail",
            "description": "Страница детализации типа встречи."
          },
          "createModal": {
            "$ref": "#/components/schemas/MessagesAdminCreateModal",
            "description": "Модальное окно создания типа встречи."
          },
          "bookings": {
            "$ref": "#/components/schemas/MessagesAdminBookings",
            "description": "Вкладка бронирований."
          }
        },
        "description": "Раздел владельца календаря."
      },
      "MessagesAdminBookingColumns": {
        "type": "object",
        "required": [
          "when",
          "type",
          "guest"
        ],
        "properties": {
          "when": {
            "type": "string",
            "description": "Колонка времени в рамке UTC+3."
          },
          "type": {
            "type": "string",
            "description": "Колонка типа встречи."
          },
          "guest": {
            "type": "string",
            "description": "Колонка имени гостя."
          }
        },
        "description": "Заголовки колонок таблицы бронирований."
      },
      "MessagesAdminBookings": {
        "type": "object",
        "required": [
          "loading",
          "loadFailed",
          "empty",
          "columns"
        ],
        "properties": {
          "loading": {
            "type": "string",
            "description": "Подпись загрузки."
          },
          "loadFailed": {
            "type": "string",
            "description": "Не удалось загрузить бронирования."
          },
          "empty": {
            "type": "string",
            "description": "Пустой список."
          },
          "columns": {
            "$ref": "#/components/schemas/MessagesAdminBookingColumns",
            "description": "Заголовки колонок таблицы."
          }
        },
        "description": "Вкладка бронирований."
      },
      "MessagesAdminCreateModal": {
        "type": "object",
        "required": [
          "title",
          "nameLabel",
          "namePlaceholder",
          "descriptionLabel",
          "descriptionPlaceholder",
          "durationLabel",
          "cancel",
          "submit",
          "failed",
          "nameInvalid",
          "descriptionInvalid",
          "durationInvalid"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Заголовок окна."
          },
          "nameLabel": {
            "type": "string",
            "description": "Подпись поля «Название»."
          },
          "namePlaceholder": {
            "type": "string",
            "description": "Плейсхолдер поля «Название»."
          },
          "descriptionLabel": {
            "type": "string",
            "description": "Подпись поля «Описание»."
          },
          "descriptionPlaceholder": {
            "type": "string",
            "description": "Плейсхолдер поля «Описание»."
          },
          "durationLabel": {
            "type": "string",
            "description": "Подпись поля «Длительность»."
          },
          "cancel": {
            "type": "string",
            "description": "Кнопка отмены."
          },
          "submit": {
            "type": "string",
            "description": "Кнопка создания."
          },
          "failed": {
            "type": "string",
            "description": "Тип встречи не создан по технической причине."
          },
          "nameInvalid": {
            "type": "string",
            "description": "Название не прошло проверку: «от {min} до {max} символов»."
          },
          "descriptionInvalid": {
            "type": "string",
            "description": "Описание не прошло проверку: «до {max} символов»."
          },
          "durationInvalid": {
            "type": "string",
            "description": "Длительность не прошла проверку: «от {min} до {max}»."
          }
        },
        "description": "Модальное окно создания типа встречи."
      },
      "MessagesAdminMeetingTypeDetail": {
        "type": "object",
        "required": [
          "back",
          "loading",
          "loadFailed",
          "notFound",
          "duration"
        ],
        "properties": {
          "back": {
            "type": "string",
            "description": "Ссылка к списку типов."
          },
          "loading": {
            "type": "string",
            "description": "Подпись загрузки."
          },
          "loadFailed": {
            "type": "string",
            "description": "Не удалось загрузить тип встречи."
          },
          "notFound": {
            "type": "string",
            "description": "Тип встречи не найден."
          },
          "duration": {
            "type": "string",
            "description": "Строка «Длительность: {minutes} мин»."
          }
        },
        "description": "Страница детализации типа встречи."
      },
      "MessagesAdminMeetingTypes": {
        "type": "object",
        "required": [
          "create",
          "loading",
          "loadFailed",
          "empty",
          "duration"
        ],
        "properties": {
          "create": {
            "type": "string",
            "description": "Кнопка создания типа встречи."
          },
          "loading": {
            "type": "string",
            "description": "Подпись загрузки."
          },
          "loadFailed": {
            "type": "string",
            "description": "Не удалось загрузить список."
          },
          "empty": {
            "type": "string",
            "description": "Пустой список."
          },
          "duration": {
            "type": "string",
            "description": "Строка «Длительность: {minutes} мин»."
          }
        },
        "description": "Вкладка типов встреч."
      },
      "MessagesAdminTabs": {
        "type": "object",
        "required": [
          "meetingTypes",
          "bookings"
        ],
        "properties": {
          "meetingTypes": {
            "type": "string",
            "description": "Вкладка «Типы встреч»."
          },
          "bookings": {
            "type": "string",
            "description": "Вкладка «Бронирования»."
          }
        },
        "description": "Названия вкладок раздела."
      },
      "MessagesBooking": {
        "type": "object",
        "required": [
          "list",
          "wizard",
          "dateTime",
          "confirm",
          "success"
        ],
        "properties": {
          "list": {
            "$ref": "#/components/schemas/MessagesBookingList",
            "description": "Список типов встреч."
          },
          "wizard": {
            "$ref": "#/components/schemas/MessagesBookingWizard",
            "description": "Мастер записи."
          },
          "dateTime": {
            "$ref": "#/components/schemas/MessagesBookingDateTime",
            "description": "Шаг «Дата и время»."
          },
          "confirm": {
            "$ref": "#/components/schemas/MessagesBookingConfirm",
            "description": "Шаг «Имя и подтверждение»."
          },
          "success": {
            "$ref": "#/components/schemas/MessagesBookingSuccess",
            "description": "Экран подтверждённого бронирования."
          }
        },
        "description": "Гостевой сценарий."
      },
      "MessagesBookingConfirm": {
        "type": "object",
        "required": [
          "noSlotSelected",
          "nameLabel",
          "namePlaceholder",
          "nameInvalid",
          "summary",
          "submit",
          "otherTime",
          "createFailed"
        ],
        "properties": {
          "noSlotSelected": {
            "type": "string",
            "description": "Имя не заполнено."
          },
          "nameLabel": {
            "type": "string",
            "description": "Подпись поля «Имя»."
          },
          "namePlaceholder": {
            "type": "string",
            "description": "Плейсхолдер поля «Имя»."
          },
          "nameInvalid": {
            "type": "string",
            "description": "Имя не прошло проверку: «от {min} до {max} символов»."
          },
          "summary": {
            "type": "string",
            "description": "Сводка выбранного слота: «{meetingTypeName}, {day}, {time} (UTC+3)»."
          },
          "submit": {
            "type": "string",
            "description": "Кнопка подтверждения."
          },
          "otherTime": {
            "type": "string",
            "description": "Кнопка возврата к выбору времени."
          },
          "createFailed": {
            "type": "string",
            "description": "Бронирование не создано по технической причине."
          }
        },
        "description": "Шаг «Имя и подтверждение»."
      },
      "MessagesBookingDateTime": {
        "type": "object",
        "required": [
          "loading",
