{
  "mcp": {
    "servers": {
      "mantine": {
        "type": "local",
        "command": ["npx", "-y", "@mantine/mcp-server@9.8.0"]
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
