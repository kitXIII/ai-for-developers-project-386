{
  "name": "ai-for-developers-project-386",
  "version": "0.1.0",
  "description": "calendar booking service",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitXIII/ai-for-developers-project-386.git"
  },
  "bugs": {
    "url": "https://github.com/kitXIII/ai-for-developers-project-386/issues"
  },
  "homepage": "https://github.com/kitXIII/ai-for-developers-project-386/#readme",
  "author": "Nikita Konovalov",
  "license": "ISC",
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip --no-progress",
    "agent-config": "agnix --strict ."
  },
  "dependencies": {
    "@fastify/vite": "^10.0.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "agnix": "0.61.0",
    "knip": "6.44.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
