{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["client/**/*.{ts,tsx}", "server/**/*.ts", "test/**/*.ts", "*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@app/api"]
    },
    "packages/api": {
      "ignore": ["generated/**"],
      "ignoreDependencies": [
        "@typespec/http",
        "@typespec/openapi",
        "@typespec/openapi3",
        "@tanstack/react-query",
        "zod"
      ]
    }
  },
  "drizzle": {
    "config": ["server/repositories/drizzle.config.ts"]
  }
}
